{
  "name": "jaxxguitar",
  "version": "1.0.0",
  "description": "Jaxx Guitar — a free, gamified guitar learning web app. Pure static site, no build step for the web itself; this package.json exists only for the Capacitor iOS wrapper.",
  "private": true,
  "scripts": {
    "build:www": "sh scripts/build-www.sh",
    "cap:sync": "sh scripts/build-www.sh && cap sync ios",
    "cap:open:ios": "cap open ios",
    "check": "node scripts/check-shapes.mjs",
    "test:pitch": "node scripts/test-pitch.mjs",
    "test:chords": "node scripts/test-chords.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
